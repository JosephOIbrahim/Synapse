<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="synapse" label="Synapse">
    <memberTool name="synapse_panel"/>
    <memberTool name="synapse_project_setup"/>
    <memberTool name="synapse_inspect_selection"/>
    <memberTool name="synapse_inspect_scene"/>
    <memberTool name="synapse_last_result"/>
    <memberTool name="synapse_health_check"/>
    <memberTool name="synapse_generate_docs"/>
  </toolshelf>

  <tool name="synapse_panel" label="Synapse" icon="SYNAPSE_synapse">
    <helpText>Open the Synapse AI Co-Pilot panel in a pane tab.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.open_panel()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse panel error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_project_setup" label="Project Setup" icon="SYNAPSE_project_setup">
    <helpText>Set up SYNAPSE memory folders for this scene and copy a project handshake to the clipboard.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.project_setup()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse project setup error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_inspect_selection" label="Inspect Selection" icon="SYNAPSE_inspect_selection">
    <helpText>Copy a structured summary of the selected nodes to the clipboard for pasting into Claude.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.inspect_selection()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse inspect error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_inspect_scene" label="Inspect Scene" icon="SYNAPSE_inspect_scene">
    <helpText>Copy a structured overview of the whole scene to the clipboard for pasting into Claude.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.inspect_scene()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse scene inspect error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_last_result" label="Last Result" icon="SYNAPSE_last_result">
    <helpText>Copy the most recent Synapse execution result to the clipboard.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.copy_last_result()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse result copy error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_health_check" label="Health Check" icon="SYNAPSE_health_check">
    <helpText>Scan the scene for node errors, warnings, and setup issues, then copy the report to the clipboard.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.health_check()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse health check error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>

  <tool name="synapse_generate_docs" label="Generate Docs" icon="SYNAPSE_generate_docs">
    <helpText>Copy full documentation of the selected nodes (parameters and connections) to the clipboard.</helpText>
    <script scriptType="python"><![CDATA[
try:
    import synapse_shelf
    synapse_shelf.generate_docs()
except Exception as e:
    hou.ui.displayMessage(
        "Synapse docs error: {}".format(e),
        severity=hou.severityType.Error
    )
]]></script>
  </tool>
</shelfDocument>
