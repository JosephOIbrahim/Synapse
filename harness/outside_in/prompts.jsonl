{"id": "sop-01", "domain": "SOP", "prompt": "Create a polygon sphere roughly one unit in radius and leave it displayed.", "check": {"nodes": [{"type": "sphere", "min": 1}], "cook": {"type": "sphere"}}, "notes": "empty-scene proof prompt; simplest task"}
{"id": "sop-02", "domain": "SOP", "prompt": "Build a box and raise it two units along Y using a transform.", "check": {"nodes": [{"type": "box", "min": 1}, {"type": "xform", "min": 1}], "parm": {"type": "xform", "name": "ty", "equals": 2.0, "tol": 0.001}}, "notes": "exercises the parm-value check kind"}
{"id": "sop-03", "domain": "SOP", "prompt": "Make a flat grid and subdivide it once so it carries more polygons.", "check": {"nodes": [{"type": "grid", "min": 1}, {"type": "subdivide", "min": 1}], "cook": {"type": "subdivide"}}, "notes": "structural + cook"}
{"id": "sop-04", "domain": "SOP", "prompt": "Scatter points across a sphere and copy a small box onto every point.", "check": {"nodes": [{"type": "sphere", "min": 1}, {"type": "scatter", "min": 1}, {"type": "copytopoints", "min": 1}], "cook": {"type": "copytopoints"}}, "notes": "instancing pipeline"}
{"id": "pyro-01", "domain": "Pyro", "prompt": "Set up a basic smoke simulation using a sphere as the emission source.", "check": {"nodes": [{"type": "pyrosolver", "min": 1}, {"type": "pyrosource", "min": 1}]}, "notes": "structural: setup built, sim not cooked (too heavy for headless verify)"}
{"id": "pyro-02", "domain": "Pyro", "prompt": "Create a fiery explosion setup driven by temperature and fuel from a sphere.", "check": {"nodes": [{"type": "pyrosolver", "min": 1}, {"type": "pyrosource", "min": 1}]}, "notes": "structural"}
{"id": "pyro-03", "domain": "Pyro", "prompt": "Emit smoke from a sphere and let it rise and dissipate.", "check": {"nodes": [{"type": "pyrosolver", "min": 1}, {"type": "pyrosource", "min": 1}]}, "notes": "structural"}
{"id": "pyro-04", "domain": "Pyro", "prompt": "Build a dense smoke plume rising from a small sphere source.", "check": {"nodes": [{"type": "pyrosolver", "min": 1}, {"type": "pyrosource", "min": 1}]}, "notes": "structural"}
{"id": "vellum-01", "domain": "Vellum", "prompt": "Set up a piece of cloth from a grid and let it fall under gravity.", "check": {"nodes": [{"type": "grid", "min": 1}, {"type": "vellumconstraints", "min": 1}, {"type": "vellumsolver", "min": 1}]}, "notes": "structural"}
{"id": "vellum-02", "domain": "Vellum", "prompt": "Make a soft-body sphere that jiggles when it settles.", "check": {"nodes": [{"type": "sphere", "min": 1}, {"type": "vellumconstraints", "min": 1}, {"type": "vellumsolver", "min": 1}]}, "notes": "structural"}
{"id": "vellum-03", "domain": "Vellum", "prompt": "Create a balloon from a sphere that inflates with pressure.", "check": {"nodes": [{"type": "sphere", "min": 1}, {"type": "vellumconstraints", "min": 1}, {"type": "vellumsolver", "min": 1}]}, "notes": "structural"}
{"id": "vellum-04", "domain": "Vellum", "prompt": "Simulate a small pile of grains settling on the ground.", "check": {"nodes": [{"type": "vellumconstraints", "min": 1}, {"type": "vellumsolver", "min": 1}]}, "notes": "structural"}
{"id": "lop-01", "domain": "Solaris/LOP", "prompt": "Import some SOP geometry into a USD stage.", "check": {"nodes": [{"type": "sopimport", "min": 1}], "cook": {"type": "sopimport"}}, "notes": "LOP context (/stage)"}
{"id": "lop-02", "domain": "Solaris/LOP", "prompt": "Reference a USD asset into the stage and add a dome light for illumination.", "check": {"nodes": [{"type": "reference", "min": 1}, {"type": "domelight", "min": 1}]}, "notes": "LOP context"}
{"id": "lop-03", "domain": "Solaris/LOP", "prompt": "Create a material library in the stage and bind a material to the geometry.", "check": {"nodes": [{"type": "materiallibrary", "min": 1}]}, "notes": "LOP context"}
{"id": "lop-04", "domain": "Solaris/LOP", "prompt": "Add render settings and a camera to the stage so it is ready for Karma.", "check": {"nodes": [{"type": "rendersettings", "min": 1}, {"type": "camera", "min": 1}]}, "notes": "LOP context"}
{"id": "cop-01", "domain": "Copernicus", "prompt": "Generate a procedural fractal noise texture in a Copernicus network.", "check": {"nodes": [{"type": "fractalnoise", "min": 1}]}, "notes": "Cop category"}
{"id": "cop-02", "domain": "Copernicus", "prompt": "Build a cellular worley-noise pattern to drive a texture.", "check": {"nodes": [{"type": "worleynoise", "min": 1}]}, "notes": "Cop category"}
{"id": "cop-03", "domain": "Copernicus", "prompt": "Color-correct an image and then blur it in a Copernicus network.", "check": {"nodes": [{"type": "colorcorrect", "min": 1}, {"type": "blur", "min": 1}]}, "notes": "Cop category"}
{"id": "cop-04", "domain": "Copernicus", "prompt": "Create a ramp gradient and layer a fractal noise on top of it.", "check": {"nodes": [{"type": "ramp", "min": 1}, {"type": "fractalnoise", "min": 1}]}, "notes": "Cop category"}
{"id": "vex-01", "domain": "VEX", "prompt": "Use a wrangle to color every point of a sphere red.", "check": {"nodes": [{"type": "attribwrangle", "min": 1}], "cook": {"type": "attribwrangle"}, "attrib": {"type": "attribwrangle", "class": "point", "name": "Cd"}}, "notes": "exercises the attrib check kind"}
{"id": "vex-02", "domain": "VEX", "prompt": "Write a point attribute called height equal to each point's Y position using a wrangle.", "check": {"nodes": [{"type": "attribwrangle", "min": 1}], "cook": {"type": "attribwrangle"}, "attrib": {"type": "attribwrangle", "class": "point", "name": "height"}}, "notes": "attrib check"}
{"id": "vex-03", "domain": "VEX", "prompt": "Use a wrangle to push the points of a grid up along their normals.", "check": {"nodes": [{"type": "grid", "min": 1}, {"type": "attribwrangle", "min": 1}], "cook": {"type": "attribwrangle"}}, "notes": "structural + cook"}
