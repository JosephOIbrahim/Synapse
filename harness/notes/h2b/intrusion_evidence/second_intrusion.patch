+def test_scene_template_emits_one_connected_chain_live(lopnet):
+    """H2/M11: the emitted chain is checked against the LIVE graph, not a literal.
+
+    The H2 mutation matrix detached `karmarendersettings` from the chain
+    (`rs.setInput(0, prev)` -> `pass`) and NOTHING went red. Both existing
+    pins missed it for the same reason: `verify_static()` reads the
+    `EXPECTED_TOPOLOGY` literal rather than the graph the tool actually built,
+    and `test_scene_template_creates_full_chain_live` asserts only node COUNT
+    and presence, never connectivity. A "full chain" test that never checks the
+    chain is chained is the F3/F5 defect class turned on the verifier itself.
+
+    Fails when: the tool leaves any emitted node unwired — i.e. the network
+    presents more than one terminal LOP, the terminal is not the render ROP, or
+    any created node is unreachable upstream from that terminal.
+    """
+    st_mod.execute({"parent": lopnet.path(), "sop_paths": ["/obj/a"]})
+    kids = list(lopnet.children())
+    assert len(kids) >= 6, [n.name() for n in kids]
+
+    terminals = [n for n in kids if not n.outputs()]
+    assert len(terminals) == 1, (
+        "scene_template emitted a detached node — expected ONE terminal LOP, got "
+        f"{[n.name() for n in terminals]}")
+    assert terminals[0].type().name() == "usdrender_rop", terminals[0].type().name()
+
+    # Everything the tool created must be reachable upstream from the terminal.
+    seen, stack = set(), [terminals[0]]
+    while stack:
+        n = stack.pop()
+        if n.path() in seen:
+            continue
+        seen.add(n.path())
+        stack.extend(i for i in n.inputs() if i is not None)
+    orphans = {n.path() for n in kids} - seen
+    assert not orphans, f"nodes unreachable from the terminal: {sorted(orphans)}"
+
