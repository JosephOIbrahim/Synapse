-HOUDINI_BUILD = os.environ.get("SYNAPSE_TEST_HOUDINI_BUILD", "21.0.671")
+def _running_build() -> str:
+    """Resolve HOUDINI_BUILD to the build actually running (H2 / RES-R1).
+
+    The contract two lines above — "tests that pin against the RUNNING build
+    parametrize on HOUDINI_BUILD" — was violated by a bare literal default. A
+    real `hou` was resident (22.0.368) while this constant said 21.0.671, so
+    four tests asserted H21 facts against an H22 host. They had passed only
+    because a FAKE `hou` resolved back to H21 and agreed with the literal;
+    removing the fake residency (RES) unmasked them (RES-F7), and RES-R1
+    deposited the disposition here because H2 is the leg that can measure it.
+
+    Precedence: explicit override > live host > committed literal.
+    The literal survives for the gate interpreter, which has no `hou` at all —
+    there is no running build to read there, so nothing changes on that leg.
+    """
+    override = os.environ.get("SYNAPSE_TEST_HOUDINI_BUILD")
+    if override:
+        return override
+    try:
+        import hou  # noqa: PLC0415 - deliberately lazy; absent on the gate leg
+        # A fake/canonical `hou` must NOT be believed here: that is the exact
+        # mechanism that produced RES-F7. Only a module that reports a real
+        # version string is trusted.
+        if not getattr(hou, "__synapse_canonical__", False):
+            live = hou.applicationVersionString()
+            if isinstance(live, str) and live.count(".") == 2:
+                return live
+    except Exception:
+        pass
+    return "21.0.671"
+
+
+HOUDINI_BUILD = _running_build()
 HOUDINI_BUILD_TUPLE = tuple(int(p) for p in HOUDINI_BUILD.split("."))
 
