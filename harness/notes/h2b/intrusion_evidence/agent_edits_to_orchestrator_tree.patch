+def _remediation_for(node_type: str) -> str:
+    """The remediation the RESOLVED catalog declares for a known-absent type.
+
+    H2/RES-F7: these pins used to hardcode the H21 wording
+    ("use a cube with sy=0.01"). That passed only while a FAKE `hou` made the
+    loader fall back to the H21 catalog. On live 22.0.368 the loader correctly
+    resolves lop_solaris_knowledge_22.json, whose grid remediation is worded
+    differently ("...grid is a Sop type — use the plane LOP..."), so the pins
+    failed against a validator that was behaving correctly.
+
+    Deriving from the catalog keeps the pin build-agnostic WITHOUT weakening
+    it: it still fails if the validator stops emitting the remediation at all.
+    """
+    cat = load_lop_catalog()
+    assert cat, "no LOP catalog resolved — the pin below would be vacuous"
+    absent = (cat.get("content") or {}).get("known_absent") or {}
+    entry = absent.get(node_type) or {}
+    text = entry.get("remediation") or ""
+    # Law 1: an empty remediation would make `text in message` always true.
+    assert len(text) > 10, f"catalog has no usable remediation for {node_type!r}"
+    return text
+
+
 _GEO = _node("geo", "sphere", "geo_sphere")
 _MATLIB = _node("matlib", "materiallibrary", "matlib")
 _ASSIGN = _node("assign", "assignmaterial", "assign_material")
