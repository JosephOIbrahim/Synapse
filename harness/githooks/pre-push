#!/bin/sh
# Gate C, enforced by capability rather than by command form.
#
# F1 found that harness/*-settings.json deny rules are written against a command
# FORM: `Bash(git push:*)` matches `git push ...` and does NOT match
# `git -C <path> push`. Every agent profile in this repo had that hole, and no
# amount of additional patterns closes it - `git --git-dir=`, `--work-tree=`, a
# shell alias, or a python subprocess all bypass a form matcher.
#
# A hook runs on the CAPABILITY. It does not care how git was invoked, by whom,
# or from which working directory.
#
# Gate C is a POSITIVE ACT, not the absence of a prohibition: pushing master
# requires deliberately setting SYNAPSE_GATE_C=1 for that one command. An agent
# will not do that by accident, and a human doing it has said so out loud.
#
#   SYNAPSE_GATE_C=1 git push origin master                                          (sh)
#   $env:SYNAPSE_GATE_C=1; git push origin master; Remove-Item Env:SYNAPSE_GATE_C    (PowerShell)
#
# Installed via core.hooksPath so it is versioned and survives a fresh clone -
# .git/hooks is not in the tree and would be lost on the next checkout.

z40=0000000000000000000000000000000000000000

# --- Gate C, protected paths over the pushed range ---------------------------
#
# harness/githooks/pre-commit fences VERSION, harness/state/** and
# harness/verify/*_baseline.json at COMMIT time. Git runs no commit-half hook
# for `git cherry-pick` or `git revert`, so either verb lands a protected path
# with pre-commit silent - ordinary porcelain, one command, no --no-verify.
#
# The capability argument applies to itself: the fence also belongs where the
# work actually leaves the machine. This checks EVERY COMMIT in the pushed
# range, not the net diff - a cherry-pick followed by a revert has an empty net
# diff and must still be caught.
#
# Stated edge: when the ref is new to the remote (remote_sha is all-zero) the
# range is `<local> --not --remotes`. With no remote-tracking refs yet - a
# fresh clone that has never fetched - that is the whole history, so the check
# errs toward refusing rather than toward passing.
protected_in_range() {
    _revs="$(git rev-parse --git-path gate-c-revs.$$)"
    _names="$(git rev-parse --git-path gate-c-names.$$)"
    if ! git rev-list "$@" </dev/null > "$_revs" 2>/dev/null; then
        rm -f "$_revs" "$_names"
        printf '%s\n' "<could not read the pushed range>"
        return 0
    fi
    : > "$_names"
    while IFS= read -r _sha; do
        git diff-tree -r -z --root --no-commit-id --name-only --no-renames "$_sha" </dev/null 2>/dev/null
    done < "$_revs" >> "$_names"
    tr '\0' '\n' < "$_names" | while IFS= read -r _path; do
        case "$_path" in
            VERSION|harness/state/*|harness/verify/*_baseline.json)
                printf '%s\n' "$_path"
                ;;
        esac
    done | sort -u
    rm -f "$_revs" "$_names"
}

while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/master|refs/heads/main)
            if [ "$local_sha" = "$z40" ]; then
                echo "pre-push: REFUSED - deleting $remote_ref is never permitted." >&2
                exit 1
            fi
            if [ "$SYNAPSE_GATE_C" != "1" ]; then
                echo "" >&2
                echo "  pre-push REFUSED: $remote_ref is Gate C." >&2
                echo "" >&2
                echo "  Gate C is the human merge gate. It is not protected by a deny" >&2
                echo "  rule - deny rules match a command FORM and are bypassed by" >&2
                echo "  'git -C <path> push' (F1 finding, 2026-07-26)." >&2
                echo "" >&2
                echo "  To push master deliberately:" >&2
                echo "      SYNAPSE_GATE_C=1 git push origin master" >&2
                echo "  PowerShell:" >&2
                echo "      \$env:SYNAPSE_GATE_C=1; git push origin master; Remove-Item Env:SYNAPSE_GATE_C" >&2
                echo "" >&2
                exit 1
            fi
            echo "pre-push: Gate C override present. Pushing $remote_ref." >&2
            ;;
    esac

    # Protected paths, EVERY ref - not just master. This is the half that
    # catches `git cherry-pick` and `git revert`, which never ran pre-commit.
    if [ "$local_sha" != "$z40" ]; then
        # Gate what this push ADDS to the remote - never what range arithmetic
        # happens to sweep in. This used `$remote_sha..$local_sha` for an
        # existing ref, and that is wrong after a rebase: a force-push breaks
        # ancestry, so git hands us the OLD head and the two-dot range swallows
        # every master commit the branch was rebased over. Observed 2026-09-15:
        # a six-file panel branch containing ZERO VERSION commits was refused on
        # VERSION, because master's own release bumps fell inside the range.
        # Every feature branch rebased after a release hit this.
        #
        # `--not --remotes` excludes only commits already on a remote ref, and
        # those were gated when they got there. The cherry-pick and revert half
        # is untouched: either verb mints a NEW sha that is on no remote, so it
        # is still walked. Same idiom the new-ref branch already used, which is
        # why the two cases now collapse into one.
        hits=$(protected_in_range "$local_sha" --not --remotes)
        if [ -n "$hits" ]; then
            if [ "$SYNAPSE_GATE_C" != "1" ]; then
                echo "" >&2
                echo "  pre-push REFUSED: a commit in the pushed range touches a Gate C path." >&2
                echo "" >&2
                printf '%s\n' "$hits" | while IFS= read -r path; do
                    echo "      $path" >&2
                done
                echo "" >&2
                echo "  Checked per COMMIT, not as a net diff: 'git cherry-pick' and" >&2
                echo "  'git revert' run no commit-half hook, so pre-commit never saw" >&2
                echo "  these, and a cherry-pick undone by a revert has an empty net" >&2
                echo "  diff while still rewriting VERSION twice." >&2
                echo "" >&2
                echo "  To push this deliberately:" >&2
                echo "      SYNAPSE_GATE_C=1 git push ..." >&2
                echo "  PowerShell:" >&2
                echo "      \$env:SYNAPSE_GATE_C=1; git push ...; Remove-Item Env:SYNAPSE_GATE_C" >&2
                echo "" >&2
                exit 1
            fi
            echo "pre-push: Gate C override present. Pushed range touches protected path(s):" >&2
            printf '%s\n' "$hits" | while IFS= read -r path; do
                echo "    $path" >&2
            done
        fi
    fi
done

exit 0
