# SYNAPSE .env.example -- copy to .env (gitignored) and fill in.
# NO SECRETS IN THIS FILE. Real API keys go in .env only, never here.
#
# Who reads .env: synapse.host.auth._load_dotenv at Houdini boot, with
# setdefault semantics (a variable already in the environment wins; an EMPTY
# exported value also wins and shadows the file -- host/auth.py R164).
# Shell tools (.synapse/hytest.py, scripts/*.py) do NOT source this file:
# export the same names in your shell. PowerShell one-liner:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process') }

# --- Houdini build pin (B10) -------------------------------------------------
# The hytest shim runs the PySide-bound tests under this hython. Pin it: a host
# with several 22.0.x builds would otherwise run probes on a build with no
# committed symbol table. 22.0.400 is the stamped build
# (python/synapse/cognitive/tools/data/h22_symbol_table.json "houdini_version";
# python/synapse/recipes/contracts.py SUPPORTED_BUILD).
# Check: python .synapse/hytest.py --which
SYNAPSE_HYTHON=C:/Program Files/Side Effects Software/Houdini 22.0.400/bin/hython.exe

# Houdini prefs root. Set explicitly: Documents may be OneDrive-redirected, and
# install.py + hython look at the pre-redirect path otherwise.
HOUDINI_USER_PREF_DIR=C:/Users/<you>/Documents/houdini22.0

# Load the repo package file in place (alternative to
# scripts/install_synapse_package.py, which writes a resolved copy into prefs).
# HOUDINI_PACKAGE_DIR=C:/path/to/SYNAPSE/packages

# --- Memory substrate (Moneta) ----------------------------------------------
# packages/synapse.json derives these from SYNAPSE_ROOT (Moneta cloned BESIDE
# the repo: <parent>/Moneta). Set them here only for headless hython runs that
# bypass the package file; otherwise leave commented.
# MONETA_SRC=C:/path/to/Moneta/src
# PXR_PLUGINPATH_NAME=C:/path/to/Moneta/schema
# SYNAPSE_MEMORY_BACKEND=moneta

# --- API keys (leave EMPTY here; fill in .env only) -------------------------
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
